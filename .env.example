# Base de datos PostgreSQL usada por Prisma.
# Ejemplo local: postgresql://usuario:password@localhost:5432/pixel
DATABASE_URL=

# Puerto del backend Express. Si el proyecto no lo define, usara el valor por defecto del codigo.
PORT=3000

# Secreto para firmar JWT. Usa un valor largo y privado en cada ambiente.
JWT_SECRET=

# Duracion de la sesion JWT. Ejemplos validos: 8h, 12h, 1d.
JWT_EXPIRES_IN=8h

# URL publica del frontend. Se usa para construir links de recuperacion:
# ${FRONTEND_URL}/reset-password/${token}
# Si no se configura, el backend usa http://localhost:5173 solo para desarrollo local.
FRONTEND_URL=http://localhost:5173

# Configuracion SMTP para envio de correos.
# No hardcodear credenciales reales en el repositorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente visible en correos enviados por el backend.
# Ejemplo: PIXEL <no-reply@tudominio.com>
SMTP_FROM=

# Correo interno opcional para notificar nuevas cotizaciones publicas al staff.
STAFF_EMAIL=

# Texto opcional para correos de pedido finalizado.
# Ejemplo: "Puedes reclamarlo de lunes a sabado de 9 a.m. a 6 p.m. en nuestra tienda."
# Si no se configura, se enviara un mensaje generico para coordinar la entrega.
PIXEL_DELIVERY_INFO=
