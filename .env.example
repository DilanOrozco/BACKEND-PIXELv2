# Base de datos PostgreSQL usada por Prisma.
# Ejemplo local: postgresql://usuario:password@localhost:5432/pixel
DATABASE_URL=

# Puerto del backend Express. Si el proyecto no lo define, usara el valor por defecto del codigo.
PORT=3000

# Secreto para firmar JWT. Usa un valor largo y privado en cada ambiente.
JWT_SECRET=

# Duracion de la sesion JWT. Ejemplos validos: 8h, 12h, 1d.
JWT_EXPIRES_IN=8h

# URL publica del frontend. Se usa para construir links de recuperacion:
# ${FRONTEND_URL}/reset-password/${token}
# Si no se configura, el backend usa http://localhost:5173 solo para desarrollo local.
FRONTEND_URL=http://localhost:5173

# Dias de vigencia usados cuando administracion no envia validaHasta.
QUOTE_VALIDITY_DAYS=7

# Costo interno sugerido en COP por cada diseno PIXEL o grupo compartido.
# Dejar 0 para exigir revision manual del costo de diseno.
QUOTE_DESIGN_SUGGESTED_COST=0

# Configuracion SMTP para envio de correos.
# No hardcodear credenciales reales en el repositorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente visible en correos enviados por el backend.
# Ejemplo: PIXEL <no-reply@tudominio.com>
SMTP_FROM=

# Correo interno opcional para notificar nuevas cotizaciones publicas al staff.
STAFF_EMAIL=

# Texto opcional para correos de pedido finalizado.
# Ejemplo: "Puedes reclamarlo de lunes a sabado de 9 a.m. a 6 p.m. en nuestra tienda."
# Si no se configura, se enviara un mensaje generico para coordinar la entrega.
PIXEL_DELIVERY_INFO=

# Cloudinary almacena los archivos de diseno. Nunca exponer API_SECRET al frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Almacenamiento local desacoplado para comprobantes.
LOCAL_STORAGE_ENABLED=true
UPLOADS_ROOT_PATH=./uploads
PAYMENT_RECEIPTS_FOLDER=comprobantes
DESIGN_FILES_FOLDER=disenos
MAX_PAYMENT_RECEIPT_SIZE_MB=10
# Los disenos se limitan como maximo a 10 MB aunque se configure un valor mayor.
MAX_DESIGN_FILE_SIZE_MB=10

# Idioma usado por Tesseract.js. "spa" puede descargar los datos de idioma
# la primera vez si no se encuentran en la cache local del entorno.
TESSERACT_LANG=spa

# Define quien analiza los comprobantes. FRONTEND_ONLY usa las sugerencias
# del navegador y envia a revision manual cualquier lectura ausente o dudosa.
# Tesseract se conserva temporalmente para los otros modos compatibles.
# Valores: FRONTEND_ONLY, FRONTEND_WITH_BACKEND_FALLBACK, BACKEND_ONLY.
RECEIPT_ANALYSIS_MODE=FRONTEND_ONLY
