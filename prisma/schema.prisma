// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// ENUMS
// ==========================
enum EstadoCotizacion {
  PENDIENTE
  APROBADA
  ANULADA
}

enum EstadoPedido {
  PENDIENTE
  EN_PROCESO
  PENDIENTE_SALDO_FINAL
  FINALIZADO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  COMPLETO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

enum EstadoAbono {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
}

enum EstadoDiseno {
  PENDIENTE
  ENVIADO
  APROBADO
  RECHAZADO
}

enum EstadoCompra {
  PENDIENTE
  COMPRADA
  ANULADA
}

// ==========================
// MODELOS
// ==========================

model Rol {
  idRol       Int     @id @default(autoincrement()) @map("id_rol")
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.VarChar(255)
  estado      Boolean @default(true)

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  idPermiso     Int      @id @default(autoincrement()) @map("id_permiso")
  codigo        String   @unique @db.VarChar(100)
  modulo        String   @db.VarChar(50)
  accion        String   @db.VarChar(50)
  descripcion   String?  @db.VarChar(255)
  estado        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  idRol         Int      @map("id_rol")
  idPermiso     Int      @map("id_permiso")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  rol     Rol     @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  permiso Permiso @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@map("roles_permisos")
}

model Usuario {
  idUsuario          Int      @id @default(autoincrement()) @map("id_usuario")
  idRol              Int      @map("id_rol")
  nombre             String   @db.VarChar(100)
  documento          String?  @unique @db.VarChar(30)
  telefono           String?  @db.VarChar(20)
  direccion          String?  @db.VarChar(150)
  correo             String   @unique @db.VarChar(100)
  contrasenaHash     String   @map("contrasena_hash") @db.VarChar(255)
  estado             Boolean  @default(true)
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  rol Rol @relation(fields: [idRol], references: [idRol], onDelete: Cascade)

  cotizacionesCreadas Cotizacion[]         @relation("CotizacionCreador")
  abonosConfirmados   Abonos[]             @relation("AbonosConfirmados")
  abonosRechazados    Abonos[]             @relation("AbonosRechazados")
  disenos             Diseno[]
  disenosRespondidos  Diseno[]             @relation("DisenosRespuestaRegistrada")
  disenosRecibidos    Diseno[]             @relation("DisenosRecibidos")
  comprasRealizadas   Compra[]
  passwordResetTokens PasswordResetToken[]
  cliente             Cliente?

  @@map("usuarios")
}

model PasswordResetToken {
  idPasswordResetToken Int       @id @default(autoincrement()) @map("id_password_reset_token")
  idUsuario            Int       @map("id_usuario")
  tokenHash            String    @map("token_hash") @db.VarChar(128)
  fechaExpiracion      DateTime  @map("fecha_expiracion")
  fechaUso             DateTime? @map("fecha_uso")
  fechaCreacion        DateTime  @default(now()) @map("fecha_creacion")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([idUsuario, fechaExpiracion])
  @@map("password_reset_tokens")
}

model Cliente {
  idCliente          Int      @id @default(autoincrement()) @map("id_cliente")
  idUsuario          Int?     @unique @map("id_usuario")
  nombre             String   @db.VarChar(100)
  documento          String?  @db.VarChar(30)
  correo             String?  @db.VarChar(100)
  telefono           String?  @db.VarChar(20)
  direccion          String?  @db.VarChar(150)
  estado             Boolean  @default(true)
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  usuario      Usuario?     @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull)
  cotizaciones Cotizacion[]
  pedidos      Pedido[]

  @@index([correo])
  @@index([telefono])
  @@index([documento])
  @@map("clientes")
}

model Tecnica {
  idTecnica          Int      @id @default(autoincrement()) @map("id_tecnica")
  nombre             String   @unique @db.VarChar(80)
  descripcion        String?  @db.VarChar(255)
  estado             Boolean  @default(true)
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  detallesCotizacion DetalleCotizacion[]
  detallesPedido     DetallePedido[]

  @@map("tecnicas")
}

model ProductoCotizable {
  idProducto          Int      @id @default(autoincrement()) @map("id_producto")
  idCategoriaProducto Int?     @map("id_categoria_producto")
  nombre              String   @unique @db.VarChar(150)
  descripcion         String?  @db.VarChar(255)
  precioBase          Decimal  @map("precio_base") @db.Decimal(10, 2)
  estado              Boolean  @default(true)
  fechaCreacion       DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime @updatedAt @map("fecha_actualizacion")

  categoriaProducto  CategoriaProducto?    @relation(fields: [idCategoriaProducto], references: [idCategoriaProducto], onDelete: SetNull)
  rangos             PrecioProductoRango[]
  detallesCotizacion DetalleCotizacion[]
  detallesPedido     DetallePedido[]

  @@index([idCategoriaProducto])
  @@map("productos_cotizables")
}

model CategoriaProducto {
  idCategoriaProducto Int      @id @default(autoincrement()) @map("id_categoria_producto")
  nombre              String   @unique @db.VarChar(100)
  descripcion         String?  @db.VarChar(255)
  estado              Boolean  @default(true)
  fechaCreacion       DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime @updatedAt @map("fecha_actualizacion")

  productos ProductoCotizable[]

  @@map("categorias_producto")
}

model PrecioProductoRango {
  idRango             Int      @id @default(autoincrement()) @map("id_rango")
  idProducto          Int      @map("id_producto")
  cantidadMin         Int      @map("cantidad_min")
  descuentoPorcentaje Decimal  @default(0) @map("descuento_porcentaje") @db.Decimal(5, 2)
  estado              Boolean  @default(true)
  fechaCreacion       DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime @updatedAt @map("fecha_actualizacion")

  producto ProductoCotizable @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)

  @@unique([idProducto, cantidadMin])
  @@index([idProducto, estado, cantidadMin])
  @@map("precios_producto_rangos")
}

model Cotizacion {
  idCotizacion       Int              @id @default(autoincrement()) @map("id_cotizacion")
  idCliente          Int              @map("id_cliente")
  creadoPorId        Int?             @map("creado_por_id")
  tipoCotizacion     String           @default("NORMAL") @map("tipo_cotizacion") @db.VarChar(20)
  estado             EstadoCotizacion @default(PENDIENTE)
  subtotal           Decimal          @default(0) @db.Decimal(10, 2)
  descuentoTotal     Decimal          @default(0) @map("descuento_total") @db.Decimal(10, 2)
  costosAdicionales  Decimal          @default(0) @map("costos_adicionales") @db.Decimal(10, 2)
  total              Decimal          @default(0) @db.Decimal(10, 2)
  observaciones      String?          @db.VarChar(255)
  fechaCreacion      DateTime         @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime         @updatedAt @map("fecha_actualizacion")

  cliente   Cliente             @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade)
  creadoPor Usuario?            @relation("CotizacionCreador", fields: [creadoPorId], references: [idUsuario], onDelete: SetNull)
  detalles  DetalleCotizacion[]
  pedidos   Pedido[]            @relation("CotizacionPedidos")

  @@index([idCliente, fechaCreacion])
  @@map("cotizaciones")
}

model DetalleCotizacion {
  idDetalleCotizacion Int      @id @default(autoincrement()) @map("id_detalle_cotizacion")
  idCotizacion        Int      @map("id_cotizacion")
  idTecnica           Int?     @map("id_tecnica")
  idProducto          Int?     @map("id_producto")
  descripcion         String   @db.VarChar(255)
  cantidad            Int
  precioBase          Decimal? @map("precio_base") @db.Decimal(10, 2)
  descuentoPorcentaje Decimal? @default(0) @map("descuento_porcentaje") @db.Decimal(5, 2)
  descuentoValorUnitario Decimal? @default(0) @map("descuento_valor_unitario") @db.Decimal(10, 2)
  precioUnitario      Decimal? @map("precio_unitario") @db.Decimal(10, 2)
  costoDiseno         Decimal? @default(0) @map("costo_diseno") @db.Decimal(10, 2)
  subtotal            Decimal? @db.Decimal(10, 2)
  subtotalBruto       Decimal? @map("subtotal_bruto") @db.Decimal(10, 2)
  descuentoTotal      Decimal? @default(0) @map("descuento_total") @db.Decimal(10, 2)
  subtotalConDescuento Decimal? @map("subtotal_con_descuento") @db.Decimal(10, 2)
  imagenReferencia    String?  @map("imagen_referencia") @db.VarChar(255)
  observaciones       String?  @db.VarChar(255)

  cotizacion Cotizacion         @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade)
  tecnica    Tecnica?           @relation(fields: [idTecnica], references: [idTecnica], onDelete: SetNull)
  producto   ProductoCotizable? @relation(fields: [idProducto], references: [idProducto], onDelete: SetNull)

  @@map("detalle_cotizacion")
}

model Pedido {
  idPedido             Int          @id @default(autoincrement()) @map("id_pedido")
  idCotizacion         Int          @map("id_cotizacion")
  idCliente            Int          @map("id_cliente")
  estadoPedido         EstadoPedido @default(PENDIENTE)
  estadoPago           EstadoPago   @default(PENDIENTE)
  total                Decimal      @default(0) @db.Decimal(10, 2)
  totalPagado          Decimal      @default(0) @map("total_pagado") @db.Decimal(10, 2)
  saldoPendiente       Decimal      @default(0) @map("saldo_pendiente") @db.Decimal(10, 2)
  fechaCreacion        DateTime     @default(now()) @map("fecha_creacion")
  fechaEntregaEstimada DateTime?    @map("fecha_entrega_estimada")
  fechaFinalizado      DateTime?    @map("fecha_finalizado")
  fechaEntregado       DateTime?    @map("fecha_entregado")
  observaciones        String?

  cliente    Cliente         @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade)
  cotizacion Cotizacion      @relation("CotizacionPedidos", fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade)
  detalles   DetallePedido[]
  abonos     Abonos[]
  disenos    Diseno[]
  compras    Compra[]

  @@index([idCliente, fechaCreacion])
  @@index([idCotizacion])
  @@map("pedidos")
}

model DetallePedido {
  idDetallePedido Int     @id @default(autoincrement()) @map("id_detalle_pedido")
  idPedido        Int     @map("id_pedido")
  idTecnica       Int?    @map("id_tecnica")
  idProducto      Int?    @map("id_producto")
  descripcion     String
  cantidad        Int
  precioUnitario  Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)
  observaciones   String?

  pedido   Pedido             @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  tecnica  Tecnica?           @relation(fields: [idTecnica], references: [idTecnica], onDelete: SetNull)
  producto ProductoCotizable? @relation(fields: [idProducto], references: [idProducto], onDelete: SetNull)

  @@map("detalle_pedido")
}

model Abonos {
  idAbono           Int         @id @default(autoincrement()) @map("id_abono")
  idPedido          Int         @map("id_pedido")
  monto             Decimal     @db.Decimal(10, 2)
  metodoPago        MetodoPago
  referencia        String?
  comprobanteUrl    String?     @map("comprobante_url")
  estado            EstadoAbono @default(PENDIENTE)
  fechaCreacion     DateTime    @default(now()) @map("fecha_creacion")
  confirmadoPorId   Int?        @map("confirmado_por_id")
  fechaConfirmacion DateTime?   @map("fecha_confirmacion")
  rechazadoPorId    Int?        @map("rechazado_por_id")
  fechaRechazo      DateTime?   @map("fecha_rechazo")
  motivoRechazo     String?     @map("motivo_rechazo")

  pedido        Pedido   @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  confirmadoPor Usuario? @relation("AbonosConfirmados", fields: [confirmadoPorId], references: [idUsuario], onDelete: SetNull)
  rechazadoPor  Usuario? @relation("AbonosRechazados", fields: [rechazadoPorId], references: [idUsuario], onDelete: SetNull)

  @@map("abonos")
}

model Diseno {
  idDiseno           Int          @id @default(autoincrement()) @map("id_diseno")
  idPedido           Int          @map("id_pedido")
  idDisenador        Int?         @map("id_disenador")
  archivoUrl         String?      @map("archivo_url")
  descripcion        String?
  observaciones      String?
  estado             EstadoDiseno @default(PENDIENTE)
  origenDiseno       String       @default("DISENADOR") @map("origen_diseno") @db.VarChar(30)
  medioRecepcion     String?      @map("medio_recepcion") @db.VarChar(30)
  recibidoPorId      Int?         @map("recibido_por_id")
  fechaRecepcion     DateTime?    @map("fecha_recepcion")
  medioRespuestaCliente String?      @map("medio_respuesta_cliente") @db.VarChar(30)
  observacionesCliente  String?      @map("observaciones_cliente")
  fechaRespuestaCliente DateTime?    @map("fecha_respuesta_cliente")
  respuestaRegistradaPorId Int?      @map("respuesta_registrada_por_id")
  fechaCreacion      DateTime     @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime     @updatedAt @map("fecha_actualizacion")
  fechaEnvio         DateTime?    @map("fecha_envio")
  fechaAprobacion    DateTime?    @map("fecha_aprobacion")

  pedido                  Pedido   @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  disenador               Usuario? @relation(fields: [idDisenador], references: [idUsuario], onDelete: SetNull)
  respuestaRegistradaPor  Usuario? @relation("DisenosRespuestaRegistrada", fields: [respuestaRegistradaPorId], references: [idUsuario], onDelete: SetNull)
  recibidoPor             Usuario? @relation("DisenosRecibidos", fields: [recibidoPorId], references: [idUsuario], onDelete: SetNull)

  @@map("disenos")
}

model Proveedor {
  idProveedor        Int      @id @default(autoincrement()) @map("id_proveedor")
  nombre             String   @unique @db.VarChar(100)
  telefono           String?  @db.VarChar(20)
  correo             String?  @db.VarChar(100)
  direccion          String?  @db.VarChar(150)
  estado             Boolean  @default(true)
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  compras Compra[]

  @@map("proveedores")
}

model Compra {
  idCompra      Int          @id @default(autoincrement()) @map("id_compra")
  idPedido      Int          @map("id_pedido")
  idProveedor   Int          @map("id_proveedor")
  compradoPorId Int?         @map("comprado_por_id")
  estado        EstadoCompra @default(PENDIENTE)
  total         Decimal      @default(0) @db.Decimal(10, 2)
  fechaCompra   DateTime     @default(now()) @map("fecha_compra")
  observaciones String?

  pedido      Pedido          @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  proveedor   Proveedor       @relation(fields: [idProveedor], references: [idProveedor])
  compradoPor Usuario?        @relation(fields: [compradoPorId], references: [idUsuario], onDelete: SetNull)
  detalles    DetalleCompra[]

  @@map("compras")
}

model DetalleCompra {
  idDetalleCompra   Int     @id @default(autoincrement()) @map("id_detalle_compra")
  idCompra          Int     @map("id_compra")
  descripcionInsumo String  @map("descripcion_insumo") @db.VarChar(255)
  cantidad          Int
  costoUnitario     Decimal @map("costo_unitario") @db.Decimal(10, 2)
  subtotal          Decimal @db.Decimal(10, 2)

  compra Compra @relation(fields: [idCompra], references: [idCompra], onDelete: Cascade)

  @@map("detalle_compra")
}
